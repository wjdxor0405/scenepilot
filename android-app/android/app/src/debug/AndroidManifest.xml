<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain http so the app can reach a server on the local network while testing.
     Release builds use the main manifest alone and need an https:// server (see build-www.mjs --release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
